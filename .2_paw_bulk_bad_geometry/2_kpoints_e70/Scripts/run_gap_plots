#!/usr/bin/env bash

# Base name referencing the data files generated by the extraction script
GAP_BASE="Gap_vs_kgrid-script.dat"
GAP_FILE0="${GAP_BASE}0"
GAP_FILE1="${GAP_BASE}1"

# Create the gnuplot script file dynamically
cat > plot-gap-kgrid.gnu <<EOF
#!/usr/bin/gnuplot

# Setup terminal for screen visualization
set term x11 enhanced

set xlabel "N (NxNxN k-point mesh)"
set ylabel "Energy Gap (eV)"

# Adjust margins slightly so that labels on the edges do not get cut off
set offset graph 0.05, graph 0.05, graph 0.05, graph 0.05

# Plotting both data files:
# Column 1 = Grid size (X axis)
# Column 5 = Calculated Gap in eV (Y axis)
# Column 2 = Total number of K-points (used for the floating labels)
plot \
	'$GAP_FILE0' u 1:5 w lp pt 7 lw 2 lc rgb "blue" title "Gap vs NxNxN 000",\
	'$GAP_FILE0' u 1:5:2 w labels offset char 1,1 textcolor rgb "blue" notitle,\
	'$GAP_FILE1' u 1:5 w lp pt 7 lw 2 lc rgb "red" title "Gap vs NxNxN 111",\
	'$GAP_FILE1' u 1:5:2 w labels offset char 1,-1 textcolor rgb "red" notitle

pause -1

# Save as PDF
set term pdfcairo enhanced
set output "${GAP_BASE}.pdf"
replot

# Save as PNG
set term pngcairo enhanced size 800,600
set output "${GAP_BASE}.png"
replot
EOF

# Execute Gnuplot to render and export the images
gnuplot plot-gap-kgrid.gnu

exit
