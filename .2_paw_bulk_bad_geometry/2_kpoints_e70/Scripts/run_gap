#!/usr/bin/env bash

# Base name for the output data files
GAP_BASE="Gap_vs_kgrid-script.dat"
GAP_FILE0="${GAP_BASE}0"
GAP_FILE1="${GAP_BASE}1"

# Create or clear the files and write the headers
echo -e "# Grid\tNK_Total\tVBM(eV)\t\tCBM(eV)\t\tGap(eV)" > $GAP_FILE0
echo -e "# Grid\tNK_Total\tVBM(eV)\t\tCBM(eV)\t\tGap(eV)" > $GAP_FILE1

echo "Extracting Gap data from K-point grid files..."

# Loop through all GaN output files
for file in GaN_script.scf.out_k*; do

    # If no files match the pattern, prevent the loop from failing
    [ -e "$file" ] || continue

    # 1. Extract grid and offset from the filename (e.g., GaN_script.scf.out_k4_1)
    # We split the string using '_' as a delimiter
    grid=$(echo "$file" | awk -F'_' '{print $(NF-1)}' | tr -dc '0-9')
    offset=$(echo "$file" | awk -F'_' '{print $NF}' | tr -dc '0-9')

    # 2. Extract the actual total number of k-points from inside the file
    nktot=$(grep "number of k points" "$file" | tr -dc '0-9')

    # 3. Search for the VBM and CBM energy levels line
    line=$(grep "highest occupied, lowest unoccupied level" "$file")

    # If the file doesn't contain this line, skip it (Incomplete calculation)
    if [ -z "$line" ]; then
        echo "Warning: No energy levels found in $file"
        continue
    fi

    # 4. Extract VBM and CBM values
    vbm=$(echo "$line" | awk '{print $(NF-1)}')
    cbm=$(echo "$line" | awk '{print $NF}')

    # 5. Calculate the Gap (CBM - VBM)
    gap=$(echo "scale=4; $cbm - $vbm" | bc)

    # 6. Append the results to the correct file depending on the offset (0 or 1)
    if [ "$offset" -eq 0 ]; then
        echo -e "$grid\t$nktot\t\t$vbm\t\t$cbm\t\t$gap" >> $GAP_FILE0
    else
        echo -e "$grid\t$nktot\t\t$vbm\t\t$cbm\t\t$gap" >> $GAP_FILE1
    fi

    echo "Processed: Grid=${grid}x${grid}x${grid} Offset=${offset} -> Total K-Points=${nktot} | Gap=${gap} eV"

done

# Sort both final files numerically by the first column (Grid size)
for suffix in 0 1; do
    target="${GAP_BASE}${suffix}"
    cat $target | head -n 1 > "${target}.tmp"
    tail -n +2 $target | sort -g >> "${target}.tmp"
    mv "${target}.tmp" $target
done

echo "---"
echo "Done! Clean data saved to:"
echo "  - $GAP_FILE0 (0 0 0 grid)"
echo "  - $GAP_FILE1 (1 1 1 grid)"
