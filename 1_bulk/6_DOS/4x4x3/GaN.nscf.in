
&CONTROL
    calculation       = 'nscf'
    restart_mode      = 'from_scratch'
    prefix            = 'GaN'
    tstress           = .true.
    tprnfor           = .true.
    pseudo_dir        = "/data-fast/greenano/Students/cohort2/rojassan/Project_GaN/PSEUDO"
  outdir       = "./tmp",
  verbosity    = "high"
  wf_collect=.true.
/
&SYSTEM
  ibrav     = 4,
  A = 3.22,
  C = 5.25,
  nat       = 4,
  ntyp      = 2,
  ecutwfc   = 70,
  ecutrho   = 700,
  nbnd      = 37,
  !nspin=2
  !occupations='smearing'
  !degauss = 0.001
  !starting_magnetization=0.1
/
&ELECTRONS
  conv_thr    = 1.D-8,
  mixing_beta = 0.7D0	,
/
