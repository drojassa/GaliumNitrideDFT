
&CONTROL
    calculation       = 'scf'
    restart_mode      = 'from_scratch'
    prefix            = 'GaN'
    tstress           = .true.
    tprnfor           = .true.
    pseudo_dir        = "/data-fast/greenano/Students/cohort2/rojassan/Project_GaN/PSEUDO/DOJO-PBE-0.5-standard"
    outdir            = "./tmp"
    verbosity         = 'high'
    disk_io = 'minimal'
