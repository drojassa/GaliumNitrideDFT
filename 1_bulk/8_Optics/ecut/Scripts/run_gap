#!/usr/bin/env bash

# Output file where clean data will be saved
GAP_FILE="Gap_vs_Ecut-script.dat"

# Create or clear the file and write the header
echo -e "# Ecut(Ry)\tVBM(eV)\t\tCBM(eV)\t\tGap(eV)" > $GAP_FILE

echo "Extracting data from .out files..."

# Loop through all files matching the pattern
# Change '*.out*' if your files have a specific prefix (e.g., 'si.scf.out_*')
for file in *.out*; do

    # If no files match the pattern, prevent the loop from failing
    [ -e "$file" ] || continue

    # 1. Extract the Ecut value from the filename
    # We strip away everything that is not a digit
    ecut=$(echo "$file" | tr -dc '0-9')

    # 2. Search for the "highest occupied, lowest unoccupied level" line
    line=$(grep "highest occupied, lowest unoccupied level" "$file")

    # If the file doesn't contain this line (e.g., if the calculation crashed), skip it
    if [ -z "$line" ]; then
        echo "Warning: No energy levels found in $file (Incomplete calculation?)"
        continue
    fi

    # 3. Extract the last two numerical values from the line (VBM and CBM)
    # awk '{print $(NF-1)}' gets the second-to-last field, and '{print $NF}' gets the last one
    vbm=$(echo "$line" | awk '{print $(NF-1)}')
    cbm=$(echo "$line" | awk '{print $NF}')

    # 4. Calculate the Gap (CBM - VBM) using the Linux calculator 'bc'
    # 'scale=4' ensures we keep 4 decimal places in the subtraction
    gap=$(echo "scale=4; $cbm - $vbm" | bc)

    # 5. Append the results to our data file separated by tabs
    echo -e "$ecut\t\t$vbm\t\t$cbm\t\t$gap" >> $GAP_FILE
    echo "Processed: $file -> Ecut=$ecut Ry | Gap=$gap eV"

done

# Sort the final file numerically by the first column (Ecut)
# This is vital so Gnuplot traces the line sequentially instead of jumping around
cat $GAP_FILE | head -n 1 > "${GAP_FILE}.tmp"
tail -n +2 $GAP_FILE | sort -g >> "${GAP_FILE}.tmp"
mv "${GAP_FILE}.tmp" $GAP_FILE

echo "---"
echo "Done! Data successfully saved to: $GAP_FILE"
