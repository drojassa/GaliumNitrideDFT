&CONTROL
    calculation   = 'scf'
    restart_mode  = 'from_scratch'
    prefix        = 'Ga_atom'
    pseudo_dir    = "/data-fast/greenano/Students/cohort2/rojassan/Project_GaN/PSEUDO"
    outdir        = "./tmp"
/
&SYSTEM
    ibrav     = 1,
    A         = 15.0,
    nat       = 1,
    ntyp      = 1,
    ecutwfc   = 70,
    ecutrho   = 700,
    nspin     = 2,
nspin = 2,
occupations = 'fixed',
 tot_magnetization = 1.00,
/
&ELECTRONS
    conv_thr    = 1.D-8,
    mixing_beta = 0.7D0
/
ATOMIC_SPECIES
 Ga  69.723  Ga.pbe-dn-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS {angstrom}
 Ga 0.00 0.00 0.00
K_POINTS {automatic}
 1 1 1 0 0 0
